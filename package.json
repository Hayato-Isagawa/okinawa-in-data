{
  "name": "okinawa-in-data",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:data": "tsx scripts/validate-data.ts",
    "build:json": "tsx scripts/build-json.ts",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:lib": "node scripts/assert-test-files.mjs \"{scripts,src}/lib/__tests__/*.test.ts\" && node scripts/assert-test-results.mjs 53 \"{scripts,src}/lib/__tests__/*.test.ts\" --import tsx",
    "test:githooks": "node scripts/assert-test-files.mjs \".githooks/__tests__/*.test.mjs\" && node scripts/assert-test-results.mjs 10 \".githooks/__tests__/*.test.mjs\"",
    "test:workflows": "node scripts/assert-test-files.mjs \"scripts/__tests__/*.test.mjs\" && node scripts/assert-test-results.mjs 211 \"scripts/__tests__/*.test.mjs\"",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:all": "npm run lint && npm run format:check && npm run check && npm run check:data && npm run test:lib && npm run test:githooks && npm run test:workflows && npm run build && npm run test:e2e",
    "vrt": "npx playwright test --config playwright.vrt.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@observablehq/plot": "^0.6.17",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/topojson-client": "^3.1.5",
    "linkedom": "^0.18.14",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pagefind": "^1.6.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "ip-address": "^10.4.0",
    "undici@^7.0.0": "^7.30.0",
    "yaml": "$yaml",
    "hono": "^4.12.34",
    "body-parser": "^2.3.0",
    "brace-expansion@^1.0.0": "^1.1.17",
    "brace-expansion@^5.0.0": "^5.0.9",
    "postcss": "^8.5.25",
    "compression": "^1.8.2",
    "sharp@<0.35.5": "^0.35.5"
  }
}
