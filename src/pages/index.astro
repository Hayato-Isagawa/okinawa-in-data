---
import BaseLayout from "../layouts/BaseLayout.astro";
import DatasetCard from "../components/DatasetCard.astro";
import MapExplorer from "../components/MapExplorer.astro";
import KeyFigures from "../components/KeyFigures.astro";
import { getAllDatasets } from "../lib/datasets";

const datasets = getAllDatasets();
const recent = [...datasets]
  .sort((a, b) => {
    const lastA = a.changelog[a.changelog.length - 1]?.date ?? "";
    const lastB = b.changelog[b.changelog.length - 1]?.date ?? "";
    return lastB.localeCompare(lastA);
  })
  .slice(0, 4);

const features = [
  { title: "元の資料にすぐ戻れる" },
  { title: "CSV・JSON でそのまま使える" },
  { title: "作り方まで確かめられる" },
];
---

<BaseLayout
  title="データでみる沖縄 — 公的データを読める形で"
  description="沖縄の公的データを、地図と表とダウンロードできる形で公開しているサイトです。どの数字からも元の資料(一次出典)にたどれます。"
>
  <section class="hero-ocean mt-2 px-6 pb-28 pt-10 sm:px-10 sm:pt-14">
    <p class="display-en anim-rise text-sm font-bold tracking-[0.25em]" style="color: #67e8f9;">
      OKINAWA IN DATA
    </p>
    <h1
      class="anim-rise anim-d1 mt-3 font-bold text-white"
      style="font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1.25;"
    >
      沖縄の「いま」を、<br />
      <span class="hero-lagoon">データで見わたす。</span>
    </h1>
    <p class="anim-rise anim-d2 mt-5 max-w-2xl text-white/85">
      機関ごとの PDF に散らばる沖縄の公的データを、地図・表・ダウンロードできる形に。まずは教育と子どもの貧困から。
    </p>
    <dl class="anim-rise anim-d3 mt-8 flex flex-wrap gap-x-10 gap-y-4">
      <div>
        <dd class="display-en text-3xl font-bold" style="color: #a5f3fc;">{datasets.length}</dd>
        <dt class="text-xs font-semibold text-white/70">収録データセット</dt>
      </div>
      <div>
        <dd class="display-en text-3xl font-bold" style="color: #a5f3fc;">41</dd>
        <dt class="text-xs font-semibold text-white/70">県内市町村をカバー</dt>
      </div>
      <div>
        <dd class="display-en text-3xl font-bold" style="color: #a5f3fc;">100%</dd>
        <dt class="text-xs font-semibold text-white/70">一次資料に出典明記</dt>
      </div>
    </dl>
    <svg
      aria-hidden="true"
      viewBox="0 0 1440 120"
      preserveAspectRatio="none"
      class="absolute bottom-0 left-0 h-16 w-full"
    >
      <path d="M0,64 C240,100 480,20 720,44 C960,68 1200,110 1440,70 L1440,120 L0,120 Z" fill="rgba(165,243,252,0.10)"></path>
      <path d="M0,84 C280,50 560,110 840,86 C1080,66 1280,90 1440,80 L1440,120 L0,120 Z" fill="rgba(103,232,249,0.12)"></path>
    </svg>
  </section>

  <div class="anim-rise anim-d4 relative z-10 -mt-16 sm:px-2 lg:-mx-12">
    <MapExplorer />
  </div>

  <div class="mt-12">
    <p class="display-en text-xs font-bold tracking-[0.25em]" style="color: var(--color-accent);">KEY FIGURES</p>
    <h2 class="mt-1 text-2xl font-bold">沖縄の数字、まずこの3つ</h2>
    <div class="mt-5">
      <KeyFigures />
    </div>
  </div>

  {
    recent.length > 0 && (
      <section aria-labelledby="recent-heading" class="mt-14">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="display-en text-xs font-bold tracking-[0.25em]" style="color: var(--color-accent);">DATASETS</p>
            <h2 id="recent-heading" class="mt-1 text-2xl font-bold">
              データセット
            </h2>
          </div>
          <a href="/datasets/" class="link-underline text-sm font-bold" style="color: var(--color-accent);">
            すべて見る →
          </a>
        </div>
        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          {recent.map((meta) => (
            <DatasetCard meta={meta} />
          ))}
        </div>
      </section>
    )
  }

  <section class="on-ocean mt-14 rounded-2xl p-8 text-center" style="background: var(--color-ocean-deep);">
    <h2 class="text-xl font-bold text-white">データの作り方も、公開しています</h2>
    <p class="mx-auto mt-2 max-w-xl text-sm text-white/90" style="text-wrap: balance;">
      どの数字も、一次資料と照らし合わせてから載せています。作業の手順も公開しているので、元の資料までたどれます。
    </p>
    <ul class="mx-auto mt-6 grid max-w-2xl gap-3 text-left text-sm font-semibold text-white/95 sm:grid-cols-3">
      {features.map((f) => <li class="border-l-[3px] pl-3" style="border-color: #67e8f9;">{f.title}</li>)}
    </ul>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/methodology/" class="btn-ghost" style="border-color: rgba(255,255,255,0.6); color: #ffffff;">
        データの作り方
      </a>
      <a href="/datasets/" class="rounded-full bg-white px-6 py-2.5 font-bold" style="color: var(--color-ink-accent);">
        データセットを見る
      </a>
    </div>
  </section>
</BaseLayout>
