---
/**
 * ロゴマーク: 本島・宮古/八重山・大東の3つの島嶼群を点で置き、線で結ぶ
 * 「アトラスの結節」。点の大小と位置関係は実際の地理(南西・中央・東)に対応。
 */
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
>
  <defs>
    <linearGradient id="logo-ocean" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#22d3ee"></stop>
      <stop offset="0.55" stop-color="#0284c7"></stop>
      <stop offset="1" stop-color="#1e3a8a"></stop>
    </linearGradient>
  </defs>
  <path
    d="M6 23 L15 11 L26 18"
    stroke="url(#logo-ocean)"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <circle cx="6" cy="23" r="3.2" fill="url(#logo-ocean)"></circle>
  <circle cx="15" cy="11" r="5.2" fill="url(#logo-ocean)"></circle>
  <circle cx="26" cy="18" r="2.6" fill="url(#logo-ocean)"></circle>
</svg>
