---
import type { DatasetMeta } from "../../data/schema/dataset-meta";
import { THEME_LABELS } from "../../data/schema/dataset-meta";
import { formatDatasetUpdatedAt } from "../lib/datasets";
import { THEME_PAGES } from "../lib/themes";

interface Props {
  meta: DatasetMeta;
  /** 配置先の見出し階層に合わせる(h1 直下なら "h2") */
  headingLevel?: "h2" | "h3";
}

const { meta, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const temporalText =
  meta.temporal.coverageStart === meta.temporal.coverageEnd
    ? meta.temporal.coverageStart
    : `${meta.temporal.coverageStart}〜${meta.temporal.coverageEnd}`;
---

<article class="card card-lift p-5">
  <div class="flex flex-wrap items-center gap-2">
    {
      meta.themes.map((theme) =>
        THEME_PAGES[theme] ? (
          <a
            href={THEME_PAGES[theme]}
            class="rounded-full px-2.5 py-0.5 text-xs font-bold text-white no-underline"
            style="background: var(--color-ocean-deep);"
          >
            {THEME_LABELS[theme]}
          </a>
        ) : (
          <span
            class="rounded-full px-2.5 py-0.5 text-xs font-bold text-white"
            style="background: var(--color-ocean-deep);"
          >
            {THEME_LABELS[theme]}
          </span>
        ),
      )
    }
    {
      meta.status === "draft" && (
        <span class="rounded-full border px-2.5 py-0.5 text-xs font-semibold" style="border-color: var(--color-line); color: var(--color-sub);">
          検証中
        </span>
      )
    }
  </div>
  <Heading class="mt-2 text-lg font-bold">
    <a href={`/datasets/${meta.id}/`} class="link-underline">
      {meta.title}
    </a>
  </Heading>
  <p class="mt-2 line-clamp-3 text-sm">{meta.description}</p>
  <p class="mt-3 text-sm num" style="color: var(--color-sub);">
    {temporalText} / {meta.spatial.level}単位 /
    最終更新 {formatDatasetUpdatedAt(meta)}
  </p>
</article>
