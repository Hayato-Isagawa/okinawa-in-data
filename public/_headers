/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 0
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://static.cloudflareinsights.com https://cloudflareinsights.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# サイト内検索の索引(ADR 0005)。pagefind.js・pagefind-worker.js・wasm はファイル名がハッシュで
# ないので、毎回 ETag で確かめさせる。期限付きで残すと、Pagefind の版上げの直後に古い JS / wasm と
# 新しい索引が組み合わさり、検索が止まる(1.4.0 → 1.5.2 で再現。パッチの版上げでは動いた)
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate

# 公開統計データの配布パス。他オリジンの notebook / アプリからの fetch を許可する
# (認証なし・GET のみの静的データであり、緩和によるリスクはない)
/data/*
  Access-Control-Allow-Origin: *
